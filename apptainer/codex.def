Bootstrap: docker
From: {{ BASE_IMAGE }}

%labels
    Author mira.salmensaari@csc.fi

%arguments
    CONFIG_DIR=/etc/codex
#    SKILL_DIR=/opt/opencode/skills
    INSTALL_DIR=/opt/codex
    APP_VERSION=0.147.0
    BASE_IMAGE=satama.csc.fi/r_installation_spack/core-cpu-gcc-15.2.0@sha256:e64b470bce6bd9786d4c4f195bdb0f7827bb441c6075d0824fd5842a3aca6fe5
#    SOCKET_BRIDGE_FILE=socket-bridge

%files
    config/codex/ {{ CONFIG_DIR }}
#    config/AGENTS.md {{ CONFIG_DIR }}/
#    config/skills {{ SKILL_DIR }}
#    socket-bridge/{{ SOCKET_BRIDGE_FILE }} /opt/socket-bridge
#    job-monitoring-sdk /opt/job-monitoring-sdk

%post

    set -x

    export DEBIAN_FRONTEND=noninteractive

    # Upgrade system packages and install curl and wget for fetching install script
    dnf update -y && dnf install -y curl wget


    # Install Codex CLI

    export CODEX_NON_INTERACTIVE=true
    export CODEX_INSTALL_DIR={{ INSTALL_DIR }}/bin

    curl -fsSL https://chatgpt.com/codex/install.sh | \
        sh -s -- --release {{ APP_VERSION }}


    # Install dev tools
    dnf install -y jq perf strace valgrind


    # Install ripgrep

    # dnf still doesn't find the package after adding EPEL repo, so installing it directly.
    RIPGREP_ARCHIVE=ripgrep-15.2.0-$( arch )-unknown-linux-musl.tar.gz
    wget https://github.com/BurntSushi/ripgrep/releases/download/15.2.0/${RIPGREP_ARCHIVE} https://github.com/BurntSushi/ripgrep/releases/download/15.2.0/${RIPGREP_ARCHIVE}.sha256
    if ! $( sha256sum --check --status ${RIPGREP_ARCHIVE}.sha256 ); then
        echo "Downloading ripgrep failed"
        exit 1
    fi

    mkdir -p /opt/ripgrep && tar -xf ${RIPGREP_ARCHIVE} -C /opt/ripgrep --strip-components=1
    ln -s /opt/ripgrep/rg /usr/bin/rg


    # Install Go
    curl -fsSLO https://go.dev/dl/go1.26.4.linux-amd64.tar.gz
    tar -C /usr/local -xzf go1.26.4.linux-amd64.tar.gz
    rm go1.26.4.linux-amd64.tar.gz


#    dnf install -y python3-pip
#    # Install the job-monitoring python sdk, for the job-efficiency skill. https://gitlab.ci.csc.fi/compen/job-monitoring/job-monitoring-sdk.git
#    cd /opt/job-monitoring-sdk
#    pip install ./
#    pip install pandas

%environment
    export PATH=$PATH:/usr/local/go/bin
    export PATH={{ INSTALL_DIR }}/bin:$PATH
    export CODEX_HOME=$HOME/roihu-codex
#
#    export OPENCODE_CONFIG={{ CONFIG_DIR }}/opencode.json
#    export OPENCODE_TUI_CONFIG={{ CONFIG_DIR }}/tui.json
#
#    export OPENCODE_DISABLE_AUTOUPDATE=1

# Seems to require --writable-tmpfs to work.
#%test
#    HOME="$(mktemp -d)" opencode debug info
%runscript
    . /opt/activate.sh  > /dev/null 2>&1
    codex "$@"
