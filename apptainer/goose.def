Bootstrap: docker
From: ubuntu:24.04

%labels
    Author mira.salmensaari@csc.fi

%arguments
    GOOSE_INSTALL_DIR=/opt/goose/bin
    APP_VERSION=1.37.0

#%files
#    # This probably isn't read as is. Maybe use GOOSE_MOIM_MESSAGE_TEXT env variable or .goosehints file? Doesn't seem like goose uses AGENTS.md at all?
#    config/AGENTS.md {{ GOOSE_CONFIG_DIR }}/

%post
    export DEBIAN_FRONTEND=noninteractive
    export GOOSE_BIN_DIR={{ GOOSE_INSTALL_DIR }}

    # Upgrade system packages and install curl for fetching install script
    apt-get update && apt-get upgrade -y && apt-get install -y curl \
        bzip2

    curl -fsSL https://github.com/aaif-goose/goose/releases/download/stable/download_cli.sh | \
        GOOSE_VERSION={{ APP_VERSION }} CONFIGURE=false bash

%environment
    export PATH={{ GOOSE_INSTALL_DIR }}:$PATH

    # Goose doesn't appear to support multiple configuration files. 
    # Env variables take precedence over local config, so probably makes most sense to set critical config that way.
    export GOOSE_TELEMETRY_ENABLED="false"
    export GOOSE_MODE="approve"

%test
    goose info

%runscript
    goose "$@"
