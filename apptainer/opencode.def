Bootstrap: docker
From: {{ BASE_IMAGE }}

%labels
    Author mira.salmensaari@csc.fi

%arguments
    OPENCODE_CONFIG_DIR=/opt/opencode/config
    OPENCODE_SKILL_DIR=/opt/opencode/skills
    OPENCODE_INSTALL_DIR=/opt/opencode/bin
    APP_VERSION=1.17.0
    BASE_IMAGE=satama.csc.fi/r_installation_spack/core-cpu-gcc-15.2.0@sha256:e64b470bce6bd9786d4c4f195bdb0f7827bb441c6075d0824fd5842a3aca6fe5
    SOCKET_BRIDGE_FILE=socket-bridge

%files
    config/opencode/ {{ OPENCODE_CONFIG_DIR }}
    config/AGENTS.md {{ OPENCODE_CONFIG_DIR }}/
    config/skills {{ OPENCODE_SKILL_DIR }}
    socket-bridge/{{ SOCKET_BRIDGE_FILE }} /opt/socket-bridge
    job-monitoring-sdk /opt/job-monitoring-sdk

%post

    export DEBIAN_FRONTEND=noninteractive
    export OPENCODE_INSTALL_DIR={{ OPENCODE_INSTALL_DIR }}

    # Upgrade system packages and install curl for fetching install script
    dnf update -y && dnf install -y curl

    # Install OpenCode
    #
    # Although the README at https://github.com/anomalyco/opencode
    # claims that the install script respects the `OPENCODE_INSTALL_DIR`
    # variable, this is not implemented, so we need to do it ourselves.
    #
    curl -fsSL https://opencode.ai/install | \
        sed 's/INSTALL_DIR=.*/INSTALL_DIR=$OPENCODE_INSTALL_DIR/' | \
        bash -s -- --version {{ APP_VERSION }}

    # Install dev tools
    dnf install -y jq perf strace

    # Install ripgrep
    # dnf still doesn't find the package after adding EPEL repo, so installing it directly.
    dnf install -y https://dl.fedoraproject.org/pub/epel/9/Everything/x86_64/Packages/r/ripgrep-14.1.1-1.el9.x86_64.rpm

    # Install Go
    curl -fsSLO https://go.dev/dl/go1.26.4.linux-amd64.tar.gz
    tar -C /usr/local -xzf go1.26.4.linux-amd64.tar.gz
    rm go1.26.4.linux-amd64.tar.gz

    dnf install -y python3-pip    
    # Install the job-monitoring python sdk, for the job-efficiency skill. https://gitlab.ci.csc.fi/compen/job-monitoring/job-monitoring-sdk.git
    cd /opt/job-monitoring-sdk
    pip install ./
    pip install pandas

%environment
    export PATH=$PATH:/usr/local/go/bin
    export PATH={{ OPENCODE_INSTALL_DIR }}:$PATH

    export OPENCODE_CONFIG={{ OPENCODE_CONFIG_DIR }}/opencode.json
    export OPENCODE_TUI_CONFIG={{ OPENCODE_CONFIG_DIR }}/tui.json

    export OPENCODE_DISABLE_AUTOUPDATE=1

# Seems to require --writable-tmpfs to work.
%test
    HOME="$(mktemp -d)" opencode debug info
%runscript
    . /opt/activate.sh  > /dev/null 2>&1
    opencode "$@"
