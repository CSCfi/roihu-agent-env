Bootstrap: docker
From: {{ BASE_IMAGE }}

%labels
    Author mira.salmensaari@csc.fi

%arguments
    OPENCODE_CONFIG_DIR=/opt/opencode/config
    OPENCODE_SKILL_DIR=/opt/opencode/skills
    OPENCODE_INSTALL_DIR=/opt/opencode/bin
    OPENCODE_VERSION=1.17.0

    CLAUDE_CONFIG_DIR=/etc/claude-code
    CLAUDE_SKILL_DIR=/etc/claude-code/.claude/skills
    CLAUDE_INSTALL_DIR=/opt/claude
    CLAUDE_VERSION=2.1.223

    BASE_IMAGE=satama.csc.fi/r_installation_spack/core-cpu-gcc-15.2.0@sha256:e64b470bce6bd9786d4c4f195bdb0f7827bb441c6075d0824fd5842a3aca6fe5
    SOCKET_BRIDGE_FILE=socket-bridge

%files
    config/opencode/ {{ OPENCODE_CONFIG_DIR }}
    config/AGENTS.md {{ OPENCODE_CONFIG_DIR }}/
    config/skills {{ OPENCODE_SKILL_DIR }}

    config/claude/ {{ CLAUDE_CONFIG_DIR }}
    config/AGENTS.md {{ CLAUDE_CONFIG_DIR }}/CLAUDE.md
    config/skills {{ CLAUDE_SKILL_DIR }}

    socket-bridge/{{ SOCKET_BRIDGE_FILE }} /opt/socket-bridge
    job-monitoring-sdk /opt/job-monitoring-sdk

%post

    set -x

    export DEBIAN_FRONTEND=noninteractive


    # Upgrade system packages and install tools for fetching install scripts
    dnf update -y && dnf install -y curl wget jq

    # Install dev tools
    dnf install -y jq perf strace valgrind


    # Install ripgrep
    # dnf still doesn't find the package after adding EPEL repo, so installing it directly.
    RIPGREP_ARCHIVE=ripgrep-15.2.0-$( arch )-unknown-linux-musl.tar.gz
    wget https://github.com/BurntSushi/ripgrep/releases/download/15.2.0/${RIPGREP_ARCHIVE} https://github.com/BurntSushi/ripgrep/releases/download/15.2.0/${RIPGREP_ARCHIVE}.sha256
    if ! $( sha256sum --check --status ${RIPGREP_ARCHIVE}.sha256 ); then
        echo "Downloading ripgrep failed"
        exit 1
    fi
    mkdir -p /opt/ripgrep && tar -xf ${RIPGREP_ARCHIVE} -C /opt/ripgrep --strip-components=1
    ln -s /opt/ripgrep/rg /usr/bin/rg


    # Install Go
    curl -fsSLO https://go.dev/dl/go1.26.4.linux-amd64.tar.gz
    tar -C /usr/local -xzf go1.26.4.linux-amd64.tar.gz
    rm go1.26.4.linux-amd64.tar.gz


    # Install the job-monitoring python sdk, for the job-efficiency skill. https://gitlab.ci.csc.fi/compen/job-monitoring/job-monitoring-sdk.git
    dnf install -y python3-pip
    cd /opt/job-monitoring-sdk
    pip install ./
    pip install pandas


    # Install OpenCode
    #
    # Although the README at https://github.com/anomalyco/opencode
    # claims that the install script respects the `OPENCODE_INSTALL_DIR`
    # variable, this is not implemented, so we need to do it ourselves.
    #
    export OPENCODE_INSTALL_DIR={{ OPENCODE_INSTALL_DIR }}

    # Installer doesn't parse "latest" properly as a version, but installs it by default.
    if [[ {{ OPENCODE_VERSION }} == "latest" ]]; then
        curl -fsSL https://opencode.ai/install | \
            sed 's/INSTALL_DIR=.*/INSTALL_DIR=$OPENCODE_INSTALL_DIR/' | \
            bash
    else
        curl -fsSL https://opencode.ai/install | \
            sed 's/INSTALL_DIR=.*/INSTALL_DIR=$OPENCODE_INSTALL_DIR/' | \
            bash -s -- --version {{ OPENCODE_VERSION }}
    fi


    # Install Claude CLI
    #
    # Install to user's HOME by default and doesn't have a native way to
    # specify different location, so we modify the script.
    #

    curl -fsSL https://claude.ai/install.sh | \
        sed 's/DOWNLOAD_DIR=.*/DOWNLOAD_DIR=\/opt\/claude\/downloads/' | \
        bash -s -- {{ CLAUDE_VERSION }}

    # Check claude's actual version in case CLAUDE_VERSION is "stable" or "latest".
    claude_ver=$( ~/.local/bin/claude --version | cut -d " " -f 1 )

    # Actual binary is at ~/.local/share/claude and the installer creates a symlink to it
    # Recreate the symlink in a better location.
    rm ~/.local/bin/claude
    mv ~/.local/share/claude {{ CLAUDE_INSTALL_DIR }}
    
    mkdir -p {{ CLAUDE_INSTALL_DIR }}/bin && \
        ln -s {{ CLAUDE_INSTALL_DIR }}/claude/versions/${claude_ver} {{ CLAUDE_INSTALL_DIR }}/bin/claude


%environment
    export PATH=$PATH:/usr/local/go/bin
    export PATH={{ OPENCODE_INSTALL_DIR }}:$PATH
    export PATH={{ CLAUDE_INSTALL_DIR }}/bin:$PATH

    export OPENCODE_CONFIG={{ OPENCODE_CONFIG_DIR }}/opencode.json
    export OPENCODE_TUI_CONFIG={{ OPENCODE_CONFIG_DIR }}/tui.json
    export OPENCODE_DISABLE_AUTOUPDATE=1

    # Claude saves some config at ~/.claude.json by default, but we don't want to mount entire HOME
    export CLAUDE_CONFIG_DIR="$HOME/roihu-claude"

# Seems to require --writable-tmpfs to work.
%test
    HOME="$(mktemp -d)" opencode debug info
    claude doctor
    claude mcp list

%runscript
    . /opt/activate.sh  > /dev/null 2>&1
    "$@"
