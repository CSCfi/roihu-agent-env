#!/bin/bash
#
# opencode
#
# Wrapper script for running OpenCode in a container.
#

## TODO check if this is necessary
#if [[ $( hostname ) == *"login"* ]]; then
#    echo "ERROR: Do not run AI agents on the login node."
#    exit 1
#fi

BIND_STRING="$PWD"  # Bind current working directory by default

APP_DIRS=(
    "$HOME/.cache/opencode"
    "$HOME/.config/opencode"
    "$HOME/.local/share/opencode"
    "$HOME/.local/state/opencode"
)

EXTRA_DIRS=(
    "$HOME/.agents"
    "$HOME/.claude"
    "$TMPDIR"
)
# SLURM_MCP_BIN is exported by the module; fall back to CWD if run outside it.
# Since build_containers.sh isn't always run first, fail loudly if it's missing.
MCP_BIN="${SLURM_MCP_BIN:-$PWD/slurm-mcp-bin}"
if [[ ! -x "$MCP_BIN" ]]; then
    echo "ERROR: $MCP_BIN not found — run build_containers.sh first." >&2
    exit 1
fi

# Start the host-side server (not in the container)
"$MCP_BIN" &
SERVER_PID=$!
trap "kill $SERVER_PID 2>/dev/null" EXIT

# Wait until it's actually listening before opencode dials it
for _ in $(seq 1 50); do [[ -S "$TMPDIR/slurm-mcp.sock" ]] && break; sleep 0.1; done

for path in "${APP_DIRS[@]}"; do
    mkdir -p "$path"
    BIND_STRING="${BIND_STRING},${path}"
done

for path in "${EXTRA_DIRS[@]}"; do
    if [[ -d "$path" ]]; then
        BIND_STRING="${BIND_STRING},${path}"
    fi
done

# AGENT_IMAGE is set by the module.
apptainer run -c -B "$BIND_STRING" --no-privs --cwd "$PWD" "$AGENT_IMAGE" "$@"
