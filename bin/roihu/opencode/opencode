#!/bin/bash
#
# opencode
#
# Wrapper script for running OpenCode in a container.
#

set -euo pipefail

#
# Parse arguments
#

unhandled_args=() # Save all arguments that aren't for the wrapper.
while [[ $# -gt 0 ]]; do
    case $1 in
    --roihu-help)
        echo ""
        echo "Wrapper for running OpenCode on Roihu inside a container."
        echo ""
        echo "Wrapper specific options:"
        echo "  --roihu-help              Print this message."
        echo ""
        echo "  --roihu-bind <paths>      Mount <paths> inside the container."
        echo "                            <paths> should be a comma separated list of absolute paths."
        echo "                            If the agent has its own sandbox, the directory needs to be added there as well separately."
        echo ""
        echo "  --roihu-ro-bind <paths>   Same as --roihu-bind, but paths are mounted as read-only."
        echo "                            Alternate syntax: --roihu-readonly-bind / --roihu-read-only-bind."
        echo ""
        echo "Remaining arguments are passed to OpenCode as is."
        echo ""
        exit 0
        ;;
    --roihu-bind)
        user_binds="$2"
        shift # past argument
        shift # past value
        ;;
    --roihu-ro-bind)
        user_ro_binds="$2"
        shift # past argument
        shift # past value
        ;;
    --roihu-readonly-bind)
        user_ro_binds="$2"
        shift # past argument
        shift # past value
        ;;
    --roihu-read-only-bind)
        user_ro_binds="$2"
        shift # past argument
        shift # past value
        ;;
    *)
        unhandled_args+=("$1") # save unhandled arg / arg value.
        shift # past argument / value
        ;;
    esac
done
set -- "${unhandled_args[@]}" # restore unhandled args.


#
# Also handle AGENT_BIND_PATHS for now, but add a warning about deprecation.
#

if [ ! -z "${AGENT_BIND_PATHS:-}" ]; then
    echo ""
    echo -e "\033[1;33m WARNING:\033[0m Using AGENT_BIND_PATHS is deprecated."
    echo "  Use --roihu-bind-paths <paths> instead."
    echo "  Run opencode --roihu-help for usage details"
    echo ""
fi

bind_string="$PWD" # Bind current working directory by default
# Add user defined normal binds. Read-only binds are handled later.
if [ ! -z "${AGENT_BIND_PATHS:-}" ]; then
    bind_string="${bind_string},${AGENT_BIND_PATHS}"
fi
if [ ! -z "${user_binds:-}" ]; then
    bind_string="${bind_string},${user_binds}"
fi

APP_DIRS=(
    "${XDG_CACHE_HOME:-$HOME/.cache}/opencode"
    "${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
    "${XDG_DATA_HOME:-$HOME/.local/share}/opencode"
    "${XDG_STATE_HOME:-$HOME/.local/state}/opencode"
)

EXTRA_DIRS=(
    "$HOME/.agents"
    "$TMPDIR"
)

READONLY_DIRS=(
    "/appl"
    "/usr/lib"
    "/usr/lib64"
)
# Parse user defined read-only paths.
IFS=',' read -r -a temparr <<< "${user_ro_binds:-""}"
READONLY_DIRS=( "${READONLY_DIRS[@]}" "${temparr[@]}" )


# Resolve the versioned Slurm MCP server binary (slurm-mcp-bin-<version>).
#
# Precedence:
#   1. SLURM_MCP_BIN  — an explicit, pinned path to one binary (set by the module
#      or the caller). Wins if it points at an executable.
#   2. Newest slurm-mcp-bin-* in SLURM_MCP_DIR (default: $PWD), by version order.
#
# SLURM_MCP_DIR is exported by the module; fall back to CWD if run outside it.
mcp_dir="${SLURM_MCP_DIR:-$PWD}"

# Pick the highest version. `sort -V` orders 0.9.0 < 0.10.0 correctly (unlike
# a plain lexical sort). compgen lists matches without a literal fallback when
# none exist, so an empty result is handled by the check below.
mcp_bin=$(compgen -G "$mcp_dir/slurm-mcp-linux-$( arch )-v*" | sort -V | tail -n1) || true


if [[ -z "$mcp_bin" || ! -x "$mcp_bin" ]]; then
    echo "ERROR: no slurm-mcp-$( arch ) found in $mcp_dir — deploy slurm mcp first." >&2
    exit 1
fi

# Start the host-side server (not in the container)
"$mcp_bin" &
server_pid=$!
trap "kill $server_pid 2>/dev/null" EXIT

# Wait until it's actually listening before opencode dials it
for _ in $(seq 1 50); do [[ -S "$TMPDIR/slurm-mcp.sock" ]] && break; sleep 0.1; done


# Combine all bind paths
for path in "${APP_DIRS[@]}"; do
    mkdir -p "$path"
    bind_string="${bind_string},${path}"
done

for path in "${EXTRA_DIRS[@]}"; do
    if [[ -d "$path" ]]; then
        bind_string="${bind_string},${path}"
    fi
done

for path in "${READONLY_DIRS[@]}"; do
    if [[ -d "$path" ]]; then
        bind_string="${bind_string},${path}:${path}:ro"
    fi
done


# Check if we are on login nodes and limit resources if yes.
# TODO: Check if these are desired or not
resource_limits=""
#hosttype=$( hostname | cut -d "-" -f 3)
#if [[ "$hosttype" == *"login"* ]]; then
#    # 5G soft limit and 10G hard limit.
#    # Cpu limits don't seem to work unfortunately. Seems like apptainer can't figure out what is the maximum cores on the machine.
#    resource_limits="--memory-reservation 5G --memory 10G"
#fi

# AGENT_IMAGE is set by the module.
apptainer run -c -B "$bind_string" --no-privs --cwd "$PWD" $resource_limits "$AGENT_IMAGE" opencode "$@"
