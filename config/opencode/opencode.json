{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "aitta": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Aitta",
            "options": {
                "baseURL": "https://aitta-api.csc.fi/openai/v1",
                "apiKey": "{env:AITTA_KEY}"
            },
            "models": {
                "Qwen/Qwen3-Coder-Next": {
                    "name": "Qwen/Qwen3-Coder-Next",
                    "options": {
                        "reasoningEffort": "high",
                        "textVerbosity": "low"
                    }
                },
                "LumiOpen/Llama-Poro-2-70B-Instruct": {},
                "allenai/OLMo-7B-0724-Instruct": {},
                "LumiOpen/Poro-34B-chat": {},
                "lightonai/modernbert-embed-large": {},
                "Unbabel/Tower-Plus-9B": {},
                "TinyLlama/TinyLlama-1.1B-Chat-v1.0": {},
                "meta-llama/Llama-3.3-70B-Instruct": {},
                "Qwen/Qwen3-VL-30B-A3B-Thinking": {},
                "intfloat/multilingual-e5-large": {},
                "openai/gpt-oss-120b": {},
                "mistralai/Ministral-3-14B-Reasoning-2512": {},
                "swiss-ai/Apertus-70B-Instruct-2509": {},
                "swiss-ai/Apertus-8B-Instruct-2509": {},
                "google/gemma-3-27b-it": {},
                "MiniMaxAI/MiniMax-M2.7": {},
                "Qwen/Qwen3.6-27B": {},
                "TurkuNLP/gpt3-finnish-small": {},
                "NCSR-Demokritos/kaLlamaki": {},
                "Qwen/Qwen3.6-35B-A3B": {},
                "nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-BF16": {},
                "google/gemma-4-31b-it": {}


            }
        }
    },
    "autoupdate": false,
    "instructions": ["/opt/opencode/config/AGENTS.md"],
    "mcp": {
        "slurm": {
            "type": "local",
            "command": ["/opt/socket-bridge"],
            "enabled": true
        }
    },
    "permission": {
        "*": "ask",
        "slurm_*": "allow"
    }
}