{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "aitta": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Aitta",
            "options": {
                "baseURL": "https://aitta-api.csc.fi/openai/v1",
                "apiKey": "{env:AITTA_KEY}"
            },
            "models": {
                "Qwen/Qwen3-Coder-Next": {
                    "name": "Qwen/Qwen3-Coder-Next",
                    "options": {
                        "reasoningEffort": "high",
                        "textVerbosity": "low"
                    }
                },
                "google/gemma-4-31b-it": {}
            }
        }
    },
    "autoupdate": false,
    "instructions": ["/opt/opencode/config/AGENTS.md"],
    "mcp": {
        "slurm": {
            "type": "local",
            "command": ["/opt/socket-bridge"],
            "enabled": true
        }
    },
    "permission": {
        "*": "ask",
        "slurm_*": "allow",
        "ls": "allow",
        "echo": "allow",
        "grep": "allow",
        "cd": "allow",
        "cat": "allow",
        "which": "allow",
        "/opts/docs/*": "allow"
    }
}