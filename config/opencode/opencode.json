{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "aitta": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Aitta",
            "options": {
                "baseURL": "https://aitta-api.csc.fi/openai/v1",
                "apiKey": "{env:AITTA_KEY}"
            },
            "models": {
                "google/gemma-4-31b-it": {},
                "openai/gpt-oss-120b": {}
            }
        }
    },
    "autoupdate": false,
    "instructions": ["/opt/opencode/config/AGENTS.md"],
    "mcp": {
        "slurm": {
            "type": "local",
            "command": ["/opt/socket-bridge"],
            "enabled": true
        }
    },
    "skills": {
        "paths": ["/opt/opencode/skills"]
    },
    "permission": {
        "*": "ask",
        "read": "allow",
        "slurm_*": "allow",
        "grep *": "allow",
        "bash": {
            "*": "ask",
            "ls *": "allow",
            "echo *": "allow",
            "grep *": "allow",
            "cd *": "allow",
            "cat *": "allow",
            "which *": "allow",
            "head *": "allow"
        },
        "external_directory": {
            "/opt/docs/*": "allow",
            "/opt/opencode/skills/*": "allow"
        },
        "skill": {
            "*": "ask",
            "software-environments": "allow",
            "batch-scripts": "allow"
        }
    }
}