{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "aitta": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Aitta",
            "options": {
                "baseURL": "https://aitta-api.csc.fi/openai/v1/chat/completions"
            },
            "models": {
                "Qwen3-Coder-Next": {
                    "name": "Qwen/Qwen3-Coder-Next",
                    "options": {
                        "reasoningEffort": "high",
                        "textVerbosity": "low"
                    }
                },
                "Qwen/Qwen3.6-27B": {
                    "name": "Qwen/Qwen3.6-27B"
                }
                

            }
        }
    },
    "autoupdate": false,
    "instructions": ["/opt/opencode/config/AGENTS.md"],
    "mcp": {
        "slurm": {
            "type": "local",
            "command": ["/opt/socket-bridge"],
            "enabled": true
        }
    },
    "permission": {
        "*": "ask",
        "slurm_*": "allow"
    }
}