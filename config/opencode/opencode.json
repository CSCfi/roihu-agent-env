{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "aitta": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Aitta",
            "options": {
                "baseURL": "https://aitta-api.csc.fi/openai/v1",
                "apiKey": "{env:AITTA_KEY}"
            },
            "models": {
                "google/gemma-4-31b-it": {},
                "openai/gpt-oss-120b": {}
            }
        }
    },
    "autoupdate": false,
    "instructions": ["/opt/opencode/config/AGENTS.md"],
    "mcp": {
        "slurm": {
            "type": "local",
            "command": ["/opt/socket-bridge"],
            "enabled": true
        },
        "csc-docs": {
            "type": "remote",
            "url": "https://roihu-agents.2.rahtiapp.fi/mcp",
            "enabled": true
        }
    },
    "skills": {
        "paths": ["/opt/opencode/skills"]
    },
    "permission": {
        "*": "ask",
        "read": "allow",
        "slurm_*": "allow",
        "csc-docs_*": "allow",
        "todowrite": "allow",
        "grep *": "allow",
        "bash": {
            "*": "ask",
            "ls *": "allow",
            "echo *": "allow",
            "grep *": "allow",
            "cd *": "allow",
            "cat *": "allow",
            "which *": "allow",
            "head *": "allow",
            "tail *": "allow",
            "python3 /opt/opencode/skills/job-efficiency/scripts/list_jobs.py": "ask",
            "python3 /opt/opencode/skills/job-efficiency/scripts/seff_single_job.py": "ask",
            "seff *": "deny",
            "sacct *": "deny",
            "sbatch *": "deny",
            "squeue *": "deny",
            "scontrol *": "deny",
            "sinfo *": "deny",
            "srun": "deny"
        },
        "edit": {
          "/opt/opencode/skills/job-efficiency/scripts/*": "deny"
        }
        "external_directory": {
            "*": "ask",
            "/opt/opencode/skills/*": "allow"
        },
        "skill": {
            "*": "ask",
            "job-efficiency": "allow",
            "software-environments": "allow",
            "batch-scripts": "allow"
        }
    }
}
