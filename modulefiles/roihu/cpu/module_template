-- LUMI AI Factory agent environment module
--
-- This module enables use of the LUMI AI Factory's containerized environment
-- for running AI coding agents on LUMI in a more secure manner.
--

help([[
This a Roihu port of LUMI AI Factory agent environment.

The LUMI AI Factory agent environment is a containerized environment
for running AI coding agents on LUMI in a more secure manner.

This module provides the following commands:
* opencode
* claude
* codex (experimental)

More information:
* https://gitlab.ci.csc.fi/compen/hpc-support/roihu-agent-env
* opencode / codex / claude --roihu-help
]])

--
-- Make this module mutually exclusive with the other agent environments.
-- Both provide overlapping wrappers and set the same env vars (AGENT_IMAGE,
-- SLURM_MCP_DIR), so only one may be loaded at a time. family() makes Lmod
-- refuse to load this module while any module of the same family is loaded.
--

family("agent_env")


-- Hardcode location for deployment.
local root = "/appl/soft/manual/general/x86_64/roihu-agent-env"

--
-- Specify the container image.
--

setenv("AGENT_IMAGE", pathJoin(root, "images/__AGENT_IMAGE_NAME__"))

-- Path to the host-side Slurm MCP server binary. The opencode/goose wrapper launches this.
setenv("SLURM_MCP_DIR", pathJoin(root, "bin/slurm-mcp"))

--
-- Add executables to `PATH`
--

prepend_path("PATH", pathJoin(root, "bin/roihu/opencode"))
prepend_path("PATH", pathJoin(root, "bin/roihu/claude"))
prepend_path("PATH", pathJoin(root, "bin/roihu/codex"))

--
-- Print load message
--

if mode() == "load" then
    LmodMessage(
        "\n" ..
        "=========================================================\n" ..
        "CAUTION: Loaded Roihu agent environment module.\n" ..
        "=========================================================\n" ..
        "\n" ..
        "* Data privacy: The default OpenCode model is hosted by the\n" ..
        "  company maintaining OpenCode. If you use this model, any data\n" ..
        "  you enter will be sent to the company.\n" ..
        "  Behaviour of Claude and Codex will depend on the type of your\n" ..
        "  subscription\n" ..
        "* Data security: Your current working directory and any\n" ..
        "  subdirectories are accessible inside the environment.\n" ..
        "\n" ..
        "Run `module help " .. myModuleName() .. "` for more information.\n" ..
        "Or run opencode / claude / codex --roihu-help for list of wrapper arguments."
    )
end
